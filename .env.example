# Template for a new league. Copy to leagues/<league>/.env and fill it in.
#
# A league lives entirely in its own folder:
#
#   leagues/<league>/
#     .env                  this file
#     league_config.json    base language, quiet hours, hidden commands
#     division_config.json  points, team size, pick timers, channel
#     sheet_layout.json     sheet tabs, columns, card grid
#     coaches.json          written by /sync_coaches
#     data/                 draft state, caches, aliases
#     logs/bot.log
#
# Start it with LEAGUE_DIR pointing at that folder — see run_arma.ps1:
#
#   $env:LEAGUE_DIR = "leagues/arma"; python main.py
#
# Every path above is derived from LEAGUE_DIR. Override one only if a league
# genuinely needs a file somewhere else (SHEET_LAYOUT_FILE, DIVISION_CONFIG_FILE,
# LEAGUE_CONFIG_FILE, COACHES_CONFIG_FILE, DATA_DIR, LOG_FILE).

# Discord
DISCORD_TOKEN=
GUILD_ID=

# Google Sheets
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json

# Discord channels & roles
ADMIN_ROLE_ID=
MOD_ROLE_ID=
ADMIN_LOG_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
DRAFT_PARTICIPANT_ROLE_ID=
REPLACEMENT_ROLE_ID=

# Lock division channels on draft pause (only admins/mods can chat). true/false
LOCK_CHANNEL_ON_PAUSE=true

# Pick bank — seconds to wait after primary snipe before fallback (default 30 minutes)
BANK_SNIPE_PAUSE_SECONDS=1800
# Shorter pause during /simulate_draft and /simulate_system (default 30 seconds)
SIMULATION_BANK_SNIPE_PAUSE_SECONDS=30

# Google Sheets write queue (one shared board lane, paced + small batches)
# Flush window is a short coalesce so near-simultaneous picks share one API call.
SHEETS_BATCH_FLUSH_SECONDS=0.4
SHEETS_BATCH_MAX_SIZE=5
SHEETS_MAX_WRITES_PER_MINUTE=55

# Base language and timezone live in league_config.json.
# Set these only to override the JSON without editing it.
# DEFAULT_LOCALE=en
# DEFAULT_TIMEZONE=Europe/Lisbon
